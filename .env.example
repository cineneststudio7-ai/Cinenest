# GEMINI_API_KEY: Required for Gemini AI API calls (script expansion, prompt generation, comment moderation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RUNWAY_API_KEY: Optional. Used by CineNest Studio for Runway Gen-2 / Gen-3 video shot rendering.
# When absent, CineNest Studio operates in high-fidelity deterministic studio simulation mode.
RUNWAY_API_KEY=""

# SUPER_ADMIN_EMAIL: Primary Super Admin and Owner of CineNest Studio
SUPER_ADMIN_EMAIL="cinenest.studio7@gmail.com"
